# ══════════════════════════════════════════════════════════════════════════
# ASINInsight — required environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 random bytes. Never reuse across environments.
FLASK_SECRET_KEY=

# ── Site URL ──────────────────────────────────────────────────────────────
# REQUIRED in production. Your public domain including scheme.
# Controls: CORS origin check, CSRF cookie Secure flag, same-origin guard.
# Example: https://asininsight.com
# Leave blank for local development only.
SITE_URL=

# ── Paddle (payments) ─────────────────────────────────────────────────────
# Client-side token (safe to expose to browser):
#   Paddle Dashboard → Developer → Authentication → Client-side token
PADDLE_CLIENT_TOKEN=

# Price IDs:
#   Paddle Dashboard → Catalog → Products → [product] → Prices
PADDLE_PRICE_PRO=pri_
PADDLE_PRICE_AGENCY=pri_

# Webhook secret (server-side only — never expose to browser):
#   Paddle Dashboard → Developer → Notifications → [webhook] → Secret key
PADDLE_WEBHOOK_SECRET=

# Server-side API key (optional — for future Paddle API calls):
#   Paddle Dashboard → Developer → Authentication → API keys
PADDLE_API_KEY=

# ── Anthropic Claude (Pro-tier LLM insights) ──────────────────────────────
# Optional. When unset, /api/diagnose silently degrades to rule-based output
# and NO LLM calls are ever made. The free tier never calls the LLM.
#   Anthropic Console → API keys
ANTHROPIC_API_KEY=
# Model + per-call timeout (seconds). Defaults are sane; override only if needed.
LLM_MODEL=claude-opus-4-7
LLM_TIMEOUT_S=8
# Spend circuit breaker: hard ceiling on Anthropic API calls per UTC day,
# across ALL users. Backstop against a runaway bill if plan-gating or the
# per-IP limit are ever bypassed. At <$0.02/call the default 2000 caps
# worst-case spend near $40/day. Set 0 to disable.
# IMPORTANT: this only bounds our process. Also set a hard spend limit in the
# Anthropic Console (Settings → Limits / Workspace spend limit) — that is the
# authoritative cap that no code can be bypassed.
LLM_DAILY_CALL_BUDGET=2000
# Spend ALERT: email OWNER_EMAIL (below) the first time daily LLM calls reach
# this count, so you are warned the moment usage-based API charges start
# accruing ON TOP of any flat subscription. 1 = warn on the first paid call of
# the day (one email/day, deduplicated). 0 disables. Needs OWNER_EMAIL +
# SENDGRID_API_KEY set.
LLM_SPEND_ALERT_THRESHOLD=1
# Where spend alerts (and owner notices) are sent. Set to your own email.
OWNER_EMAIL=

# ── SendGrid (email reports) ───────────────────────────────────────────────
# SendGrid Dashboard → Settings → API Keys → Create API Key
# Permission needed: Mail Send
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=reports@yourdomain.com
EMAIL_FROM_NAME=ASINInsight

# ── Amazon SP-API (optional — for Connect Amazon Store feature) ────────────
# Seller Central → Apps & Services → Develop Apps → [your app]
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Must exactly match the OAuth redirect URI you registered with Amazon:
AMAZON_REDIRECT_URI=https://yourdomain.com/amazon/callback

# ── Database ──────────────────────────────────────────────────────────────
# Railway sets this automatically when you add a Postgres plugin.
# If blank, ASINInsight falls back to SQLite (local dev only).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=
