# ── Secrets — NEVER commit these ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────
venv/
.venv/
env/
.env_/

# ── Database files — contain real user/payment data ───────────────────────
*.db
*.sqlite
*.sqlite3
asininsight.db

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS / editor noise ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Beta test responses (may contain real user feedback) ──────────────────
beta_testing/responses/*.json
!beta_testing/responses/RESP-XXX-*.json

# ── Local dev artefacts — may contain live session cookies / API responses ─
# These are produced by curl --cookie-jar / smoke-test scripts during local
# development and may capture real session IDs, CSRF tokens, or diagnose
# response payloads. Never commit them.
cookies*.txt
live_cookies.txt
live*.txt
server_out.txt
diag_result.json
diag_*.json
test_data.csv
output/
validation_output/
validation/real_data/

# Tooling state ───────────────────────────────────────────────────────────
.claude/
.cursor/
.aider*
